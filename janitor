#!/usr/bin/env python3

import argparse
import subprocess
import sys
from pathlib import Path

BASE = Path(__file__).resolve().parent
SCRIPTS = BASE / "scripts"


def call_script(name, args):
    script = SCRIPTS / name
    if not script.is_file():
        raise SystemExit(f"Missing helper: {script}")
    return subprocess.call([sys.executable, str(script), *args])


def run_script(name, args):
    raise SystemExit(call_script(name, args))


def add_common_display_args(parser):
    parser.add_argument("--verbose", action="store_true", help="Show filenames and detailed decisions")
    parser.add_argument("--redact-report", action="store_true", help="Redact filenames and origin URLs in CSV output")


def organizer_args(ns, only, allow_apply=True):
    args = []
    if getattr(ns, "root", None):
        args += ["--root", ns.root]
    args += ["--only", only]
    if getattr(ns, "verbose", False):
        args.append("--verbose")
    if getattr(ns, "redact_report", False):
        args.append("--redact-report")
    if allow_apply and getattr(ns, "apply", False):
        args.append("--apply")
    if allow_apply and getattr(ns, "include_review", False):
        args.append("--include-review")
    if allow_apply and getattr(ns, "yes", False):
        args.append("--yes")
    return args


def main():
    parser = argparse.ArgumentParser(
        prog="janitor",
        description="Privacy-first, report-first cleanup helpers for macOS Downloads.",
    )
    parser.add_argument("--root", default=None, help="Downloads root (default: ~/Downloads)")
    sub = parser.add_subparsers(dest="command", required=True)

    scan = sub.add_parser("scan", help="Audit top-level Downloads and show sorting summary")
    scan.add_argument("--only", choices=["all", "pdf", "zip", "dmg", "media", "gpt", "documents", "sensitive", "junk"], default="all")
    add_common_display_args(scan)

    organize = sub.add_parser("organize", help="Sort safe top-level Downloads into managed folders")
    organize.add_argument("--only", choices=["all", "pdf", "zip", "dmg", "media", "gpt", "documents", "sensitive", "junk"], default="all")
    organize.add_argument("--apply", action="store_true", help="Actually move safe/high-confidence files")
    organize.add_argument("--include-review", action="store_true", help="Also move review candidates into staging folders")
    organize.add_argument("--yes", action="store_true", help="Skip confirmation with --apply")
    add_common_display_args(organize)

    dup = sub.add_parser("duplicates", help="List duplicate ZIP/DMG archives")
    dup.add_argument("--kind", choices=["all", "zip", "dmg"], default="all")

    gpt = sub.add_parser("gpt", help="ChatGPT-origin downloads")
    gpt_sub = gpt.add_subparsers(dest="gpt_command", required=True)
    gpt_scan = gpt_sub.add_parser("scan", help="Audit ChatGPT-origin top-level files")
    add_common_display_args(gpt_scan)
    gpt_org = gpt_sub.add_parser("organize", help="Move confirmed ChatGPT-origin files under fromGPT")
    gpt_org.add_argument("--apply", action="store_true")
    gpt_org.add_argument("--include-review", action="store_true", help="Also stage probable GPT files under fromGPT/_Review")
    gpt_org.add_argument("--yes", action="store_true")
    add_common_display_args(gpt_org)

    z = sub.add_parser("zip", help="ZIP lifecycle tools")
    zsub = z.add_subparsers(dest="zip_command", required=True)
    zsub.add_parser("audit", help="Find ZIPs that appear to be extracted")
    zsub.add_parser("verify", help="CRC-verify EXACT_EXTRACTED ZIPs")
    zsub.add_parser("report", help="Run ZIP extraction audit, CRC verification and duplicate audit")
    zsub.add_parser("duplicates", help="List byte-identical and logical-content duplicate ZIPs")
    zpair = zsub.add_parser("pair", help="Pair verified ZIPs with extracted copies")
    zpair.add_argument("--apply", action="store_true")

    d = sub.add_parser("dmg", help="DMG tools")
    dsub = d.add_subparsers(dest="dmg_command", required=True)
    dsub.add_parser("audit", help="List DMGs and exact duplicates")
    dorg = dsub.add_parser("organize", help="Move top-level DMGs into _DMG")
    dorg.add_argument("--apply", action="store_true")
    dorg.add_argument("--yes", action="store_true")
    add_common_display_args(dorg)

    p = sub.add_parser("pdf", help="PDF classification tools")
    psub = p.add_subparsers(dest="pdf_command", required=True)
    paudit = psub.add_parser("audit", help="Classify top-level PDFs without moving")
    add_common_display_args(paudit)
    porg = psub.add_parser("organize", help="Move only high-confidence top-level PDFs")
    porg.add_argument("--apply", action="store_true")
    porg.add_argument("--include-review", action="store_true", help="Stage lower-confidence PDFs under _PDF/_Review")
    porg.add_argument("--yes", action="store_true")
    add_common_display_args(porg)

    pvendors = psub.add_parser("vendors", help="Discover recurring vendor/company names in top-level PDFs")
    pvendors.add_argument("--min-count", type=int, default=2, help="Minimum PDF count for recurring candidates")
    pvendors.add_argument("--verbose", action="store_true", help="Show matching filenames; private")
    pvendors.add_argument("--show-mentions", action="store_true", help="Also show recurring non-vendor company mentions")
    pvendors.add_argument("--emit-rules", action="store_true", help="Generate local draft vendor-rule suggestions")
    pvendors.add_argument("--no-pdftotext", action="store_true", help="Disable pdftotext fallback")
    pvendors.add_argument("--no-pdfkit", action="store_true", help="Disable native macOS PDFKit fallback")

    plearn = psub.add_parser("learn", help="Promote discovered vendors into private local rules")
    plearn.add_argument("--include-medium", action="store_true", help="Also include medium-confidence candidates")
    plearn.add_argument("--apply", action="store_true", help="Write rules to private local config")
    plearn.add_argument("--yes", action="store_true", help="Skip confirmation with --apply")

    m = sub.add_parser("media", help="Downloaded media/image source grouping")
    msub = m.add_subparsers(dest="media_command", required=True)
    maudit = msub.add_parser("audit", help="Group top-level media by normalized source without moving")
    add_common_display_args(maudit)
    morg = msub.add_parser("organize", help="Move top-level media into normalized source groups")
    morg.add_argument("--apply", action="store_true")
    morg.add_argument("--yes", action="store_true")
    add_common_display_args(morg)

    s = sub.add_parser("sensitive", help="Find sensitive-looking top-level filenames; never moves them")
    add_common_display_args(s)

    j = sub.add_parser("junk", help="Find zero-byte and Office temp files at Downloads root")
    j.add_argument("--apply", action="store_true", help="Stage junk candidates under _Janitor/review/junk-candidates")
    j.add_argument("--yes", action="store_true")
    add_common_display_args(j)

    ns = parser.parse_args()
    root_args = ["--root", ns.root] if ns.root else []

    if ns.command == "scan":
        run_script("downloads_organizer.py", organizer_args(ns, ns.only, allow_apply=False))
    if ns.command == "organize":
        run_script("downloads_organizer.py", organizer_args(ns, ns.only))
    if ns.command == "duplicates":
        run_script("archive_duplicates.py", [*root_args, "--kind", ns.kind])

    if ns.command == "gpt":
        run_script("downloads_organizer.py", organizer_args(ns, "gpt"))

    if ns.command == "zip":
        if ns.zip_command == "audit":
            run_script("zip_extract_audit.py", [])
        if ns.zip_command == "verify":
            run_script("zip_crc_verify.py", [])
        if ns.zip_command == "duplicates":
            run_script("archive_duplicates.py", [*root_args, "--kind", "zip"])
        if ns.zip_command == "report":
            for helper, args0 in (("zip_extract_audit.py", []), ("zip_crc_verify.py", []), ("archive_duplicates.py", [*root_args, "--kind", "zip"])):
                rc = call_script(helper, args0)
                if rc:
                    raise SystemExit(rc)
            raise SystemExit(0)
        args = ["--apply"] if ns.apply else []
        run_script("janitor_pair_zips.py", args)

    if ns.command == "dmg":
        if ns.dmg_command == "audit":
            run_script("archive_duplicates.py", [*root_args, "--kind", "dmg"])
        run_script("downloads_organizer.py", organizer_args(ns, "dmg"))

    if ns.command == "pdf":
        if ns.pdf_command == "vendors":
            args = [*root_args, "--min-count", str(ns.min_count)]
            if ns.verbose:
                args.append("--verbose")
            if ns.show_mentions:
                args.append("--show-mentions")
            if ns.emit_rules:
                args.append("--emit-rules")
            if ns.no_pdftotext:
                args.append("--no-pdftotext")
            if ns.no_pdfkit:
                args.append("--no-pdfkit")
            run_script("pdf_vendor_discovery.py", args)
        if ns.pdf_command == "learn":
            args = [*root_args]
            if ns.include_medium:
                args.append("--include-medium")
            if ns.apply:
                args.append("--apply")
            if ns.yes:
                args.append("--yes")
            run_script("pdf_vendor_promote.py", args)
        run_script("downloads_organizer.py", organizer_args(ns, "pdf"))

    if ns.command == "media":
        run_script("downloads_organizer.py", organizer_args(ns, "media"))

    if ns.command == "sensitive":
        run_script("downloads_organizer.py", organizer_args(ns, "sensitive", allow_apply=False))

    if ns.command == "junk":
        run_script("downloads_organizer.py", organizer_args(ns, "junk"))


if __name__ == "__main__":
    main()
